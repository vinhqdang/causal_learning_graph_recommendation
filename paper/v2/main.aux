\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Main comparison (seed 0, full selection). Test nDCG is mean $\pm $ sd over splits. Diff is the paired per-user difference of the final method minus the baseline, $\times 10^{-3}$, with the 95\% CI half-width. $p_{\text  {Holm}}$ is adjusted within each dataset over the block's family (sizes 8, 6, 7, 9). Bold: best of the block; underline: second (KuaiRec: within the family). The final method is tuned over 324, 84, 30 and 120 configurations (Coat, Yahoo! R3, KuaiRand, KuaiRec), against 6 to 216 for the baselines (Configs column). Rows marked re-impl.\ use a simplified AdvInfoNCE (Section~\ref {sec:advsetup}). On KuaiRec the final method ranks third within its Holm family.}}{37}{table.3}\protected@file@percent }
\newlabel{tab:main}{{3}{37}{Main comparison (seed 0, full selection). Test nDCG is mean $\pm $ sd over splits. Diff is the paired per-user difference of the final method minus the baseline, $\times 10^{-3}$, with the 95\% CI half-width. $p_{\text {Holm}}$ is adjusted within each dataset over the block's family (sizes 8, 6, 7, 9). Bold: best of the block; underline: second (KuaiRec: within the family). The final method is tuned over 324, 84, 30 and 120 configurations (Coat, Yahoo! R3, KuaiRand, KuaiRec), against 6 to 216 for the baselines (Configs column). Rows marked re-impl.\ use a simplified AdvInfoNCE (Section~\ref {sec:advsetup}). On KuaiRec the final method ranks third within its Holm family}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Training-free and other methods outside the Holm families of Table~\ref {tab:main}. Their differences to the final method were not tested. Test nDCG is mean $\pm $ sd over splits. DR adjacency is the doubly robust operator without the walk correction; DRUP adds the walk correction. On Yahoo! R3 and KuaiRand, DRUP, DR adjacency and IPS adjacency have identical means.}}{38}{table.4}\protected@file@percent }
\newlabel{tab:extra}{{4}{38}{Training-free and other methods outside the Holm families of Table~\ref {tab:main}. Their differences to the final method were not tested. Test nDCG is mean $\pm $ sd over splits. DR adjacency is the doubly robust operator without the walk correction; DRUP adds the walk correction. On Yahoo! R3 and KuaiRand, DRUP, DR adjacency and IPS adjacency have identical means}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Robustness to the training seed. Seed 0 is the main run of Table~\ref {tab:main}; seeds 1--3 retrain the selected configuration of each split and re-select only the epoch on validation data. Test nDCG per seed is the mean over splits. Each dataset has a Holm family of two paired comparisons (the two strongest baselines of the main run). The two baselines of each dataset are the two highest-scoring baselines of the main run by test mean, and they are retrained with seeds 1--3 in the same way as the final method. Diff is the paired per-user mean difference (not the difference of the two table means), $\times 10^{-3}$, with the 95\% CI half-width in brackets.}}{39}{table.5}\protected@file@percent }
